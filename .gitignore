node_modules/
dist/
automation/.env
chatops/.env
.env
.env.local
*.log
.DS_Store
coverage/

# Relatórios gerados pelo agente (Pipeline Guardian)
reports/

# Os logs de fixture do agente são código de teste, não log de execução:
# precisam escapar da regra `*.log` acima.
!automation/fixtures/logs/*.log

# Idem para os logs de contingência da aula: são material didático versionado,
# usados quando o Railway ou a rede não estão disponíveis.
!samples/deployment/*.log

# Idem para os cenários operacionais do Dia 1 (`npm run operational:fixture`).
# Os `.jsonl` e `.json` já escapam da regra `*.log`; os `.log` precisam da
# negação explícita.
!samples/operational/**/*.log

# ChatOps (FastAPI). `chatops/.env` já cai na regra `.env` acima — é lá que
# ficam o segredo do HMAC e as URLs dos webhooks do Discord.
chatops/.venv/
__pycache__/
.pytest_cache/
*.pyc
